      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A giveaway is an on-site activity run by a community member. The organiser sets the prizes and the draw time; other members spend on-site energy on tickets, and the system draws at random when the time comes."
          }
        }
      }
    },
