    "担保交易" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrow"
          }
        }
      }
    },
    "担保交易：买家付款后钱由平台代收，确认收货后扣除手续费记入卖家余额。卖家超时未发货自动退款，买家超时未确认自动结算，有争议可以申请平台介入。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrow: the platform holds the buyer's payment and credits the seller, minus the fee, once receipt is confirmed. Late shipping is refunded automatically, late confirmation settles automatically, and either side can ask the platform to step in."
          }
        }
      }
    },
