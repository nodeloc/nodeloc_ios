    "抽奖已被关闭" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lottery was closed"
          }
        }
      }
    },
    "抽奖是社区成员自己发起的站内活动。发起人设置奖项和开奖时间，其他成员用站内能量购买抽奖票参与，到时间由系统随机开奖。" : {
      "comment" : "Text describing how to participate in a lottery.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A giveaway is an on-site activity run by a community member. The organiser sets the prizes and the draw time; other members spend on-site energy on tickets, and the system draws at random when the time comes."
          }
        }
      }
    },
    "抽奖标题" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giveaway title"
